<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="网络弱网模拟"
                android:textColor="@color/hf_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="56dp"
                android:paddingHorizontal="12dp"
                android:text="返回"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 总开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开启弱网模拟"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWeakNetStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="当前：未开启"
                            android:textColor="@color/hf_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEnable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 目标 App -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="作用范围"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWeakNetTarget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="全局（所有经过 VPN 的流量）"
                            android:textColor="@color/hf_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSelectTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="@null"
                        android:minWidth="56dp"
                        android:paddingHorizontal="10dp"
                        android:text="选择"
                        android:textAllCaps="false"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnClearTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="@null"
                        android:minWidth="56dp"
                        android:paddingHorizontal="10dp"
                        android:text="清除"
                        android:textAllCaps="false"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 参数区 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="弱网参数"
                        android:textColor="@color/hf_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="参数保存后对生效中的弱网立即生效"
                        android:textColor="@color/hf_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="附加延迟 (ms)"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/editLatency"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:hint="0"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/hf_text_primary"
                            android:textColorHint="@color/hf_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="抖动 (ms)"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/editJitter"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:hint="0"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/hf_text_primary"
                            android:textColorHint="@color/hf_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="丢包率 (%)"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/editLoss"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:hint="0"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/hf_text_primary"
                            android:textColorHint="@color/hf_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="下行限速 (kbps)"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/editDown"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:hint="0=不限"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/hf_text_primary"
                            android:textColorHint="@color/hf_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="上行限速 (kbps)"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/editUp"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:hint="0=不限"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/hf_text_primary"
                            android:textColorHint="@color/hf_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 音量键控制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="音量键控制"
                            android:textColor="@color/hf_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="开启后按音量键切换弱网开关（默认关闭，避免影响系统音量）"
                            android:textColor="@color/hf_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVolumeKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:text="保存配置并应用"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="提示：单 App 模式下广告拦截临时仅作用于该 App；关闭弱网后恢复全局拦截。点击悬浮球可快速开关弱网。"
                    android:textColor="@color/hf_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>