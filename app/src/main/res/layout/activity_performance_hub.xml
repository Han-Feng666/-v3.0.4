<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="性能优化"
        android:textColor="@color/hf_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="设备状态总览 + 智能推荐 + 调度/线程优化入口"
        android:textColor="@color/hf_text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 状态总览面板 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvHubDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设备：检测中..."
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHubSnapshot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="正在采集运行状态..."
                    android:textColor="@color/hf_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvHubRootState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/hf_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 智能推荐 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="智能推荐"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHubRecommendStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="等待状态采集完成..."
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutHubRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- 功能入口 -->
            <Button
                android:id="@+id/btnHubTuner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="性能调优（调度参数）" />

            <Button
                android:id="@+id/btnHubThreadOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="线程优化" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnHubRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="刷新状态" />
</LinearLayout>
