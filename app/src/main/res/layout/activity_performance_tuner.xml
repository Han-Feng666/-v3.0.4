<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="背景"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="性能调优"
            android:textColor="@color/hf_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:minWidth="64dp"
            android:text="返回"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 状态面板 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="状态面板"
                android:textColor="@color/hf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:text="正在检测 Root 与系统状态..."
                android:textColor="@color/hf_text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDeploy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="部署模块文件"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnRefreshStatus"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="刷新状态"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />
            </LinearLayout>

            <!-- ============ CPU/GPU 频率监控 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CPU/GPU 频率监控"
                android:textColor="@color/hf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFreqMonitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:text="正在读取频率信息..."
                android:textColor="@color/hf_text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutFreqControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- ============ SCENE 调度 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SCENE 调度优化"
                android:textColor="@color/hf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="频率/调度/防降频优化。支持两个模式：独立模式（本 App 直接执行脚本，无需 Scene 工具）与 Scene 兼容模式（需要已安装 Scene 工具箱，注入其配置目录生效）。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchScene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="false"
                android:text="启动 SCENE 调度"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgSceneMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSceneStandalone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="独立模式（不依赖 Scene 工具箱）"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbSceneDep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scene 兼容模式（需已安装 Scene 工具箱）"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="调度档位"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSceneProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSceneBalanced"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="均衡"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbScenePerformance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="性能"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbSceneGame"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="游戏"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp" />

                <RadioButton
                    android:id="@+id/rbSceneDefault"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="默认"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbSceneCustom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自定义"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnSceneEditParams"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:text="编辑自定义参数"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary"
                android:visibility="gone" />

            <!-- 频率/温度墙快捷设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="频率与温度墙"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="独立设置，无需编辑自定义参数。点击进入全屏编辑页。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditFreqThermal"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="频率 / 温度墙"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnRestoreDefault"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="恢复出厂默认"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSceneLog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:text="查看 SCENE 日志"
                android:textAllCaps="false"
                android:textColor="@color/hf_text_primary" />

            <!-- 注意事项 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="注意事项"
                android:textColor="@color/hf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="2dp"
                android:text="1. 需要 Root（Magisk/KernelSU/APatch）权限。\n2. 独立模式由本 App 直接执行调度脚本，非 8Gen3 设备同样适用（自动检测拓扑）。\n3. Scene 兼容模式需要手机已安装「Scene 工具箱」应用，否则无法生效。\n4. 人为过度锁频可能导致高温/耗电，建议使用性能档位。\n5. 修改规则或参数后保存会自动重启对应守护。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
</FrameLayout>