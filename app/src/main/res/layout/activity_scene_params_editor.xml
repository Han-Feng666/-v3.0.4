<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCENE 自定义参数"
            android:textColor="@color/hf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:minWidth="64dp"
            android:text="返回"
            android:textAllCaps="false"
            android:textColor="@color/hf_text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="分项设置频率上限、温度墙等参数，无需记忆参数名。所有值仅在切换到「自定义」档位时生效。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <!-- 频率上限 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CPU 频率上限 (fmax_cap)"
                android:textColor="@color/hf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFmaxCap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="auto 或 KHz 数值，如 3196800"
                android:inputType="text"
                android:textColor="@color/hf_text_primary"
                android:textColorHint="@color/hf_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="auto 表示不限制；输入数值（单位 KHz）则强制 CPU 最高频率不超过该值。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <!-- 温度墙 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="温度墙 (°C)"
                android:textColor="@color/hf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etThermal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="默认 49.5"
                android:inputType="numberDecimal"
                android:textColor="@color/hf_text_primary"
                android:textColorHint="@color/hf_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="达到该温度阈值后 CPU 不再无限制降频。单位为 °C，范围 0-100。输入 49.5 等价于原始值 49500。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <!-- 自适应降频 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="自适应降频 (adaptive)"
                android:textColor="@color/hf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgAdaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAdaptiveOff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="关闭"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbAdaptiveOn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="开启"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="开启后允许系统按负载自适应调频，关闭则强制高频策略。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <!-- 小米 MIGT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="禁用小米 MIGT (disable_migt)"
                android:textColor="@color/hf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDisableMigt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMigtOff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="禁用"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbMigtKeep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="保留"
                    android:textColor="@color/hf_text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="仅小米/Redmi 机型有 MIGT 模块，禁用可减少游戏降频干预。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <!-- 高频负载阈值 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="高频负载阈值 (hispd_load)"
                android:textColor="@color/hf_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHispeedLoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="默认 90"
                android:inputType="number"
                android:textColor="@color/hf_text_primary"
                android:textColorHint="@color/hf_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="负载达到该百分比时进入高频档位，范围 1-100。"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRestoreDefault"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="恢复默认"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:text="保存"
                    android:textAllCaps="false"
                    android:textColor="@color/hf_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/hf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
