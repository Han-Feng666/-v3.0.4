<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass compact button (idle)：可见玻璃体 + 双层边缘反光，无内部白线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#36202020"
                android:endColor="#26181818"
                android:startColor="#48FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:top="9dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="#16000000"
                android:startColor="@android:color/transparent" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hf_glass_stroke" />
        </shape>
    </item>
</layer-list>
