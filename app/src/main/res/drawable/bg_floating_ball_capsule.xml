<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass floating ball capsule：可见玻璃体 + 边缘反光 + 底部暗部 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:top="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/hf_glass_inner_shadow"
                android:startColor="@android:color/transparent" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="59dp" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="60dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hf_glass_stroke" />
        </shape>
    </item>
</layer-list>
