<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass secondary button (idle)：可见玻璃体 + 边缘反光，无内部白线
     底色 82%-88% 白：毛玻璃观感 + 低版本可读性兜底 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#AAFFFFFF"
                android:endColor="#A0FFFFFF"
                android:startColor="#B4FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/hf_glass_inner_shadow"
                android:startColor="@android:color/transparent" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hf_glass_stroke" />
        </shape>
    </item>
</layer-list>
