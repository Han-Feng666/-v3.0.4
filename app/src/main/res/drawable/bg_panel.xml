<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass panel：可见玻璃体 + 边缘反光 + 冷蓝描边 + 轻暗部
     半透明液态玻璃：底色 61%-71% 白，Android 12+ 配合窗口 FLAG_BLUR_BEHIND 真实模糊呈现通透毛玻璃；
     低版本/省电模式由弹窗窗口 DIM + 高光描边保证可读性 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#A8FFFFFF"
                android:endColor="#9CFFFFFF"
                android:startColor="#B6FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/hf_glass_inner_shadow"
                android:startColor="@android:color/transparent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hf_glass_stroke" />
        </shape>
    </item>
</layer-list>
