<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass compact button (pressed)：玻璃体加深，边缘反光增强，无内部白线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#40202020"
                android:endColor="#2E141414"
                android:startColor="#5CFFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:top="9dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="#22000000"
                android:startColor="@android:color/transparent" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <stroke
                android:width="1dp"
                android:color="#70FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hf_glass_stroke" />
        </shape>
    </item>
</layer-list>
