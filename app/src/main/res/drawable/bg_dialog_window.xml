<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass dialog：环境投影 + 可见玻璃体 + 双层边缘反光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient drop shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hf_glass_shadow_dark" />
            <corners android:radius="24dp" />
            <padding
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="3dp" />
        </shape>
    </item>
    <!-- 玻璃体填充：较高不透明白底渐变，配合 FLAG_BLUR_BEHIND 实现毛玻璃且避免与背后文字重叠 -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#E6FFFFFF"
                android:endColor="#D9FFFFFF"
                android:startColor="#F0FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 顶部液态高光：模拟玻璃对环境光的反射，增强液态玻璃质感 -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="#5CFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 底部投影 Y≈2 黑 4% -->
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/hf_glass_inner_shadow"
                android:startColor="@android:color/transparent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <!-- 轮廓冷蓝 0.5dp / 6% -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/hf_glass_stroke" />
        </shape>
    </item>
</layer-list>
