{
  "platform": "pineapple",
  "platform_name": "8GEN3",
"alias": {
  "gpu_max_khz": "/sys/class/kgsl/kgsl-3d0/devfreq/max_freq",
  "max_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/max_cpus",
  "min_cpus_cpu7": "/sys/devices/system/cpu/cpu7/core_ctl/min_cpus",
  "max_cpus_cpu5": "/sys/devices/system/cpu5/core_ctl/max_cpus",
  "min_cpus_cpu5": "/sys/devices/system/cpu5/core_ctl/min_cpus",
  "core_ctl_5": "/sys/devices/system/cpu5/core_ctl/enable",
  "core_ctl_7": "/sys/devices/system/cpu/cpu7/core_ctl/enable",
  "perfmgr_enable": "/sys/module/perfmgr/parameters/perfmgr_enable",
  "cpu_min_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq",
  "cpu_max_5": "/sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq",
  "cpu_max_0": "/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq",
  "cpu_max_2": "/sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq",
  "cpu_max_7": "/sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq",
    "sched_boost": "/proc/sys/walt/sched_boost",
    "glk_disable": "/sys/module/migt/parameters/glk_disable",
    "input_boost": "/proc/sys/walt/input_boost/sched_boost_on_input",
    "sched_upmigrate": "/proc/sys/walt/sched_upmigrate",
    "sched_downmigrate": "/proc/sys/walt/sched_downmigrate"
  },
  "features": {
    "limiter": {
     "ddr_boost": false,
      "limiters": {
        "p1": {          
          "cpus": [
            { "max": 1804800, "min": 672000, "margins": "150" },
            { "max": 2246400, "min": 1190400, "margins": "200 1612800:120 2035200:80" },
            { "max": 2035200, "min": 960000, "margins": "200 1612800:120" },
            { "max": 2035200, "min": 902400, "margins": "200 1593200:120" }
          ]
        },
        "p2": {          
          "cpus": [
            { "max": 1459200, "min": 787200, "margins": "150" },
            { "max": 2246400, "min": 960000, "margins": "200 1708800:120" },
            { "max": 2246400, "min": 960000, "margins": "200 1708800:120" },
            { "max": 2246400, "min": 902400, "margins": "200 1708800:120" }
          ]
        },
        "p3": {                   
          "cpus": [
            { "max": 1804800, "min": 1017600, "margins": "120" },
            { "max": 2515200, "min": 1920000, "margins": "300" },
            { "max": 2515200, "min": 1920000, "margins": "300" },
            { "max": 2630400, "min": 2035200, "margins": "300" }
          ]
        },
        "p4": {                   
          "cpus": [
            { "max": 2265600, "min": 1804800, "margins": "250" },
            { "max": 3148800, "min": 2438400, "margins": "300" },
            { "max": 2956800, "min": 2438400, "margins": "300" },
            { "max": 3302400, "min": 2438400, "margins": "400" }
          ]
        },
        "inactive": {                    
          "core_ctl": [3],
          "cpus": [
            { "max": 1248000, "min": 672000, "margins": "100" },
            { "max": 1824000, "min": 614400, "margins": "120" },
            { "max": 1824000, "min": 614400, "margins": "120" },
            { "max": 1824000, "min": 672000, "margins": "100" }
          ]
        },
        "idle": {                    
          "core_ctl": [3],
          "cpus": [
            { "max": 1248000, "min": 556800, "margins": "80" },
            { "max": 1612800, "min": 614400, "margins": "80" },
            { "max": 1612800, "min": 614400, "margins": "80" },
            { "max": 1593600, "min": 672000, "margins": "80" }
          ]
        }
      }
    },
        "gesture_boost": {
            "enable": true,
            "enter": [
            ],
            "exit": [
                ["$sched_boost", "0"]
            ]
        }
    },
  "reset": [
    ["@msm_reset"],
    ["@governor", "walt"],
    ["@preset", "limiter_off"],
    ["$sched_upmigrate", "95 95 95"],
    ["$sched_downmigrate", "85 85 85"],
    ["/sys/devices/system/cpu/bus_dcvs/L3/boost_freq", "364800"],
    ["/sys/devices/system/cpu/bus_dcvs/DDR/boost_freq", "547000"],
   ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq","1555200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq","1555200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq","1555200"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/max_freq","1555200"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/min_freq","364800"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/min_freq","364800"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/min_freq","364800"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/min_freq","364800"]
  ],
  "presets": {
    "latency": [
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy0/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy2/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy2/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy5/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy5/walt/up_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us"],
      ["/sys/devices/system/cpu/cpufreq/policy7/walt/up_rate_limit_us"]
    ],
    "target_loads": [
      ["/sys/devices/system/cpu0/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu2/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu5/cpufreq/walt/target_loads"],
      ["/sys/devices/system/cpu7/cpufreq/walt/target_loads"]
    ],
    "target_load_shift": [
      ["/sys/devices/system/cpu0/cpufreq/walt/target_load_shift"],
      ["/sys/devices/system/cpu3/cpufreq/walt/target_load_shift"],
      ["/sys/devices/system/cpu7/cpufreq/walt/target_load_shift"]
    ],
    "target_load_thresh": [
      ["/sys/devices/system/cpu0/cpufreq/walt/target_load_thresh"],
      ["/sys/devices/system/cpu2/cpufreq/walt/target_load_thresh"],
      ["/sys/devices/system/cpu5/cpufreq/walt/target_load_thresh"],
      ["/sys/devices/system/cpu7/cpufreq/walt/target_load_thresh"]
    ],
    "memlat": [
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/decay_rate", "90"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/window_ms", "40"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/sample_ms", "4"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/max_freq", "#2736000"]
    ],
    "cpu7_on": [
      ["$core_ctl_7", "1"],
      ["$max_cpus_cpu7", "#1"],
      ["$min_cpus_cpu7", "#1"],
      ["$core_ctl_7", "#0"]
    ],
    "cpu7_off": [
      ["$core_ctl_7", "1"],
      ["$min_cpus_cpu7", "#0"],
      ["$max_cpus_cpu7", "#0"]
    ],
    "limiter_off": [
      ["/proc/game_opt/disable_cpufreq_limit", "#1"],
      ["/sys/module/migt/parameters/glk_disable", "#1"],
      ["/sys/module/perfmgr/parameters/perfmgr_enable", "#0"],
      ["/sys/module/migt/parameters/glk_freq_limit_walt", "#0"]
    ],
    "limiter_on": [
      ["/proc/game_opt/disable_cpufreq_limit", "0"],
      ["/sys/module/migt/parameters/glk_disable", "0"]
    ],
    "common_active": [
      ["@preset", "cpu7_on"]
    ],
    "common_inactive": [
      ["@cpu_freqs_min", "307200", "499200", "499200", "480000"],
      ["$sched_upmigrate", "95 95 95"],
      ["$sched_downmigrate", "85 85 85"], 
      ["@values", "latency", "0", "3000", "0", "3000", "0", "3000", "0", "3000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDR/min_freq", "547000"],
      ["/proc/sys/kernel/sched_conservative", "1"],
      ["/sys/module/process_reclaim/parameters/enable_process_reclaim", "1"],
      ["$sched_boost", "0"],
      ["@hispeed_load", "90", "90", "90", "90"]
    ],
    "common_app": [
      ["@governor", "walt"],
      ["@cpuset", "0-1", "0-1,5-6", "2-6", "0-7"],
      ["/dev/cpuset/sf/cpus", "#2-6"],
      ["@values", "latency", "0", "2000", "0", "2000", "0", "3000", "0", "3000"],
      ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "0"],
      ["/sys/devices/system/cpu/bus_dcvs/LLCC/24091000.qcom,bwmon-llcc/max_freq", "806000"],
      ["$mod_percent", "105"],
      ["/sys/block/zram0/hybridswap_swapd_pause", "1"]
    ],
    "common_gaming": [
      ["@preset", "common_active"],
      ["@limiter", "NONE"],
      ["@governor", "walt"],
      ["/dev/cpuset/sf/cpus", "#2-4"],
    ["$sched_upmigrate", "25 85 15"],
    ["$sched_downmigrate", "15 70 5"],
      ["@cpuset", "0-1", "0-1,5-6", "2-6", "2-7"],
      ["$sched_boost", "0"],
      ["@hispeed_load", "90", "90", "90", "90"],
      ["@values", "latency", "1000", "1000", "1000", "1000", "1000", "1000", "1000", "1000"],
         ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq","1747200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq","1747200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq","1747200"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/max_freq","1747200"],
      ["/sys/devices/system/cpu/cpu5/cpufreq/scaling_governor","performance"],
      ["/sys/devices/system/cpu/cpu6/cpufreq/scaling_governor","performance"],
      ["@gesture", "PAUSE"],
      ["/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq", "#1"],
      ["$mod_percent", "100"],
      ["/sys/block/zram0/hybridswap_swapd_pause", "0"]
    ],
      "powersave_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 902400:90",
          "85 1190400:90 1612800:95",
          "85 960000:90 1612800:95",
          "85 902400:90 1593200:95"],
        ["@limiter", "p1"],
      ["@hispeed_freq", "0", "0", "0", "0"]
    ],
      "powersave_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu7_off"],
        ["@target_loads",
          "85 902400:90",
          "85 960000:90 1401600:95",
          "85 729600:90 1401600:95",
          "85 787200:90 1478400:95"],
        ["@limiter", "idle"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ],

      "balance_active": [
        ["@preset", "common_active"],
        ["@cpu_freqs_min", "^787200", "^729600", "^729600", "^787200"],
        ["@target_loads",
          "80 1459200:90",
          "80 1401600:85 1824000:90",
          "80 1401600:85 1824000:90",
          "80 1478400:85 1824000:90"],
        ["@limiter", "p2"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ],
      "balance_inactive": [
        ["@preset", "common_inactive"],
        ["@preset", "cpu7_auto"],
        ["@target_loads",
          "85 1017600:90",
          "85 960000:90 1612800:95",
          "85 960000:90 1478400:95",
          "85 902400:90 1478400:95"],
        ["@limiter", "inactive"],
        ["@hispeed_freq", "0", "0", "0", "0"],
        ["@preset", "cpu7_off"]
      ],

      "performance_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 1574400:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2131200:90",
          "80 1708800:85 2112000:90"],
        ["@limiter", "p3"],
        ["@cpu_freqs_min", "^787200", "^844800", "^844800", "^902400"],
        ["@hispeed_freq", "0", "1075200", "1075200", "1017600"]
      ],
      "performance_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "85 1017600:90",
          "83 960000:85 1708800:90",
          "83 960000:85 1708800:90",
          "83 902400:85 1708800:90"],
        ["@limiter", "p1"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ],
      "fast_active": [
        ["@preset", "common_active"],
        ["@target_loads",
          "80 1689600:85",
          "80 2131200:85",
          "80 2131200:85",
          "80 2112000:85"],
        ["@limiter", "p4"],
        ["@cpu_freqs_min", "^2265600", "^3148800", "^2956800", "^3302400"],
        ["@hispeed_freq", "0", "1075200", "1286400", "1248000"]
      ],
      "fast_inactive": [
        ["@preset", "common_inactive"],
        ["@target_loads",
          "85 1689600:90",
          "83 1708800:87 2131200:95",
          "83 1708800:87 2131200:95",
          "83 1708800:87 2112000:95"],
        ["@limiter", "p4"],
        ["@hispeed_freq", "0", "844800", "844800", "844800"]
      ]
    },
  "schemes": {
    "powersave": {
      "call": [
        ["/sys/devices/system/cpu/cpufreq/boost", "0"]
      ],
      "app": [
        ["@preset", "common_app"],
        ["@preset", "powersave_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
   ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq","1555200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq","1555200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq","1555200"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/max_freq","1555200"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ]
    },
    "balance": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "balance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
      ["@values", "latency", "1200", "1000", "1200", "1000", "1200", "1000", "1200", "1000"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ]
    },
    "performance": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "performance_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
      ["@values", "latency", "1500", "1000", "1500", "1000", "1500", "1000", "1500", "1000"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ]
    },
    "fast": {
      "app": [
        ["@preset", "common_app"],
        ["@preset", "fast_active"]
      ],
      "game": [
        ["@preset", "common_gaming"],
        ["@preset", "limiter_off"],
      ["@values", "latency", "1500", "1000", "1500", "1000", "1500", "1000", "1500", "1000"],
       ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/max_freq","2035200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/max_freq","2035200"],
        ["sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime-compute/max_freq","2035200"],
        ["/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/max_freq","2035200"],
        ["@hispeed_freq", "0", "0", "0", "0"]
      ]
    }
  },
  "apps": [
    {
      "friendly": "ELP",
      "packages": ["IM", "Music", "Reader", "ShortVideo", "Nav", "ScrollOpt"],
      "import": "_ELP.json"
    },
    {
      "friendly": "白名单",
      "packages": [
        "com.termux",
        "xyz.chatboxapp.chatbox",
        "com.danemadsen.maid",
        "com.freakurl.apps.ollama",
        "io.github.xororz.localdream"
      ],
      "import": "_WhiteList.json"
    },
    {
      "friendly": "相机",
      "packages": [
      "Camera"
      ],
      "import": "_Camera.json"
    },
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Apps.json"
    }
  ],
  "games": [
    {
      "friendly": "All",
      "packages": ["*"],
      "import": "_Games.json"
    }
  ]
}